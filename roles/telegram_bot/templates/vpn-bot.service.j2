[Unit]
Description=VPN Control Plane Telegram Bot
After=network.target xray.service
Requires=network.target

[Service]
Type=simple
User={{ bot_user }}
Group={{ bot_group }}
WorkingDirectory={{ bot_app_dir }}
EnvironmentFile={{ bot_app_dir }}/.env
ExecStart=/usr/bin/node packages/server/dist/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpn-bot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Allow ICMP ping without setuid (AmbientCapabilities work with NoNewPrivileges=true)
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ReadWritePaths={{ bot_data_dir }} {{ xray_config_dir }}{{ ' ' + singbox_config_dir if hy2_enabled | default(false) else '' }}
# systemd creates these owned by {{ bot_user }} and adds them to ReadWritePaths itself,
# which is what makes them writable under ProtectSystem=strict. vpn-maintenance holds the
# req-<action> triggers for the maintenance path units; it is on tmpfs on purpose, so no
# trigger can survive a reboot and re-fire the job at boot.
RuntimeDirectory=vpn-bot vpn-maintenance
RuntimeDirectoryMode=0755
# Without this systemd deletes the runtime dirs every time the bot stops — which would
# also drop a trigger the bot had just written before being restarted mid-job.
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
