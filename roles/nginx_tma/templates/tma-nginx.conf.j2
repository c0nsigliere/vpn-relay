# TMA Web App — nginx config
# Generated by Ansible (roles/nginx_tma)
#
# Listens ONLY on {{ tma_https_port }} (HTTPS). Port 80 is intentionally left
# unbound so certbot --standalone (tls_cert role) can use it for issuance and
# renewal. The certificate is issued beforehand by the tls_cert role.

server {
    listen {{ tma_https_port }} ssl;
    server_name {{ tma_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ tma_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ tma_domain }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Subscription endpoint. nginx picks the LONGEST matching prefix location, so
    # this wins over `location /` regardless of ordering; it is placed first for
    # readability only.
    #
    # access_log off is the point of having a dedicated block: the token in the URL
    # IS the client's credential, and it would otherwise be written to disk on every
    # poll (apps re-fetch daily). This is narrow — it suppresses only the access log,
    # not error logs or upstream diagnostics — so the link still has to be treated
    # like a password. Cache-Control/X-Robots-Tag come from Fastify instead of here,
    # so they hold on every path including Server A's L4 fallback.
    location /sub/ {
        access_log off;
        proxy_pass http://127.0.0.1:{{ tma_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Proxy API requests to Fastify
    location /api/ {
        proxy_pass http://127.0.0.1:{{ tma_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cache_bypass $http_upgrade;
    }

    # Serve React SPA static files
    location / {
        proxy_pass http://127.0.0.1:{{ tma_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
