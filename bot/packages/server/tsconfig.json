{
  "compilerOptions": {
    "target": "ES2022",
    // node16 replaces the deprecated "Node"/node10 resolution (removed in TS 7.0).
    // Still emits CommonJS for this tsc->node package (no "type":"module").
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Tests are colocated with the code they cover; excluding them keeps vitest's
  // own types out of the build and test files out of dist/.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "references": [{ "path": "../shared" }]
}
