{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "tproxy-wg-clients",
      "listen": "0.0.0.0",
      "port": {{ xray_tproxy_port }},
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": { "tproxy": "tproxy" }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy-out",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ server_b_public_ip }}",
            "port": {{ xray_port }},
            "users": [
              {
                "id": "{{ xray_wg_uplink_uuid }}",
                "flow": "",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "{{ xray_reality_server_names[0] }}",
          "fingerprint": "{{ xray_reality_fingerprint }}",
          "publicKey": "{{ _xray_reality_pubkey | trim }}",
          "shortId": "{{ _xray_shortid | trim }}"
        }
      },
      "mux": { "enabled": true, "concurrency": 8, "xudpConcurrency": 16 }
    },
{% if _hy2_uplink_active | default(false) %}
    {
      "tag": "hy2-uplink",
      "protocol": "socks",
      "settings": {
        "servers": [
          { "address": "127.0.0.1", "port": {{ singbox_uplink_socks_port }} }
        ]
      }
    },
{% endif %}
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "ip": ["{{ server_b_public_ip }}"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": ["tproxy-wg-clients"],
        "outboundTag": "proxy-out"
      }
    ]
  }
}
{#
  Routing note: this is the BASE config. When the Hy2 uplink is active, the bot
  (running on Server B) rewrites ONLY routing.rules over SSH to insert per-client
  `source: [<wg_ip>/32] -> hy2-uplink` rules for WG clients whose wg_cascade_transport
  is 'hy2', keeping this proxy-out rule as the default. Outbounds are Ansible-owned.
  See bot/packages/server/src/services/xray-uplink.service.ts.
#}
