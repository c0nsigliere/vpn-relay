# VPN Bot environment — generated by Ansible, do not edit manually
BOT_TOKEN={{ bot_telegram_token }}
ADMIN_ID={{ bot_admin_id }}

# Database
DB_PATH={{ bot_data_dir }}/data.db

# Server A (cascade mode only — empty = standalone mode)
{% if groups.get('relay_servers', []) | length > 0 %}
SERVER_A_HOST={{ hostvars[groups['relay_servers'][0]]['ansible_host'] }}
SERVER_A_SSH_PORT=22
SERVER_A_SSH_USER={{ hostvars[groups['relay_servers'][0]]['ansible_user'] | default('root') }}
SERVER_A_SSH_KEY_PATH={{ bot_ssh_key_path }}
SERVER_A_WG_PORT={{ wg_clients_port }}
SERVER_A_RELAY_PORT={{ port_a_tcp }}
{% else %}
SERVER_A_HOST=
{% endif %}

# Server country codes (auto-resolved by GeoIP at deploy, or manual override)
{% if _server_a_country is defined and _server_a_country | length > 0 %}
SERVER_A_COUNTRY={{ _server_a_country }}
{% endif %}
{% if _server_b_country is defined and _server_b_country | length > 0 %}
SERVER_B_COUNTRY={{ _server_b_country }}
{% endif %}

# Server B (local XRay)
SERVER_B_HOST={{ server_b_public_ip }}
SERVER_B_XRAY_PORT={{ xray_port }}
XRAY_API_PORT={{ xray_api_port }}
XRAY_KEYS_DIR={{ xray_keys_dir }}
{% if xray_wg_uplink_uuid is defined and xray_wg_uplink_uuid | length > 0 %}
XRAY_WG_UPLINK_UUID={{ xray_wg_uplink_uuid }}
{% endif %}

# XRay DPI evasion
XRAY_SNI={{ xray_sni }}
XRAY_FINGERPRINT={{ xray_fingerprint }}
XRAY_FLOW={{ xray_flow }}

{% if hy2_enabled | default(false) %}
# Hysteria 2 (sing-box) — HY2_HOST may be a bare IP even with a domain HY2_DOMAIN
HY2_ENABLED=true
HY2_HOST={{ hy2_host | default(server_b_public_ip) }}
HY2_DOMAIN={{ hy2_domain }}
HY2_PORT={{ hy2_port }}
SINGBOX_CONFIG_FILE={{ singbox_config_file }}
SINGBOX_OBFS_FILE={{ singbox_obfs_file }}
SINGBOX_V2RAY_API_PORT={{ singbox_v2ray_api_port }}
{% if hy2_uplink_password is defined and hy2_uplink_password | length > 0 %}
HY2_UPLINK_PASSWORD={{ hy2_uplink_password }}
{% endif %}
{% endif %}

# OpenAI (optional — enriched update summaries)
{% if openai_api_key is defined and openai_api_key | length > 0 %}
OPENAI_API_KEY={{ openai_api_key }}
{% endif %}

# Logging
LOG_LEVEL={{ bot_log_level | default('info') }}

# TMA (Telegram Mini App)
TMA_PORT={{ tma_backend_port }}
{% if tma_domain | length > 0 %}
TMA_DOMAIN={{ tma_domain }}
TMA_URL=https://{{ tma_domain }}:{{ tma_https_port }}
{% endif %}
