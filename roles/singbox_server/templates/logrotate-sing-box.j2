/var/log/sing-box/sing-box.log {
    daily
    rotate 3
    compress
    missingok
    notifempty
    copytruncate
    postrotate
        # Ensure vpn-bot can read the log for client IP extraction (phase 2)
        setfacl -m u:vpn-bot:r /var/log/sing-box/sing-box.log 2>/dev/null || true
    endscript
}
